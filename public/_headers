# Vite fingerprints everything under /assets, so it can never go stale.
#
# This rule matches by request path, so it would happily stamp a year onto a
# reply for an asset that is not there — which is how the edge once cached a
# fallback page under the entry chunk's name and served HTML as JavaScript for
# everyone who followed. public/404.html is what stops that: with a 404 page in
# the build, a missing asset answers 404 with `no-store` instead, and this rule
# only ever lands on a file that exists. Do not remove one without the other.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The share card is not fingerprinted, and scrapers cache hard. A day is long
# enough to be free and short enough that replacing the card actually lands.
/og.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
