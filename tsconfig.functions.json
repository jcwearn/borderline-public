{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.functions.tsbuildinfo",
    "target": "es2023",
    /* Workers are a browser-like runtime: Web Crypto, fetch, Request, Response,
       and no Node globals. */
    "lib": ["ES2023", "WebWorker"],
    "types": [],
    "skipLibCheck": true,

    /* Wrangler bundles with esbuild, so bundler resolution is what actually
       runs — unlike the scripts, which Node executes directly. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "resolveJsonModule": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["functions"]
}
