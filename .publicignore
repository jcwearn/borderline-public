# rsync exclude patterns for the public snapshot.
#
# actions/checkout only materializes tracked files, so anything already in
# .gitignore will not be present anyway. Listing those paths here regardless is
# deliberate: it makes the filter correct when run locally against a dirty
# working tree, and it survives a file being accidentally committed later.
#
# Patterns are rsync filter rules, not gitignore rules. A trailing / matches
# directories only; a leading / anchors to the repo root.

# Never publish VCS or CI-local state
.git/
.github/public-README.md

# Agent / editor state
.claude/
.vscode/
.idea/
.DS_Store

# Local Cloudflare state. .dev.vars holds a local PUZZLE_SALT; the production
# one is a Pages secret and must never be published, because the whole daily
# puzzle derivation is salted with it.
.dev.vars
.dev.vars.*
.wrangler/

# Build output and local test artefacts
dist/
dist-ssr/
*.local

# Not present in CI, where checkout only materializes tracked files, but a local
# dry run copies 12,500 files without this and tells you nothing useful.
node_modules/
